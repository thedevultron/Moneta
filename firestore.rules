rules_version = '2';

// Moneta talks to Firestore ONLY through the firebase-admin SDK on the server,
// which bypasses these rules. No browser/client code touches Firestore directly,
// so default-deny everything here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
