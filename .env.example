# Moneta uses local JSON text-file storage — no database server needed.
DATA_DIR=./data

# Storage backend: json (default, local files) or firestore (Firebase).
DB_BACKEND=json

# Firebase (only needed when DB_BACKEND=firestore).
# Create a project at console.firebase.google.com → Firestore Database → Create,
# then Project Settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value; keep the \n escapes on ONE line.
FIREBASE_PRIVATE_KEY=
# ...or paste the ENTIRE service-account JSON on one line instead:
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Public site URL used for metadata / sitemap (set to your tunnel or domain in production)
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Google AI Studio key (https://aistudio.google.com/apikey) — paste full key into .env
GEMINI_API_KEY=
# Text + insights model
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
# Agentic chat model (function calling: add/edit/delete, budgets, goals, recurring)
GEMINI_AGENT_MODEL=gemini-3.5-flash
# Live voice model with extended thinking + own interactive transcription (Phase 2)
GEMINI_LIVE_MODEL=gemini-3.8-live-extended-thinking
# Server-side speech transcription fallback (fast + cheap)
GEMINI_TRANSCRIBE_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=medium

# File uploads: local (default, ./data/uploads served via /api/files/[key]),
# firebase (Firebase Storage; requires FIREBASE_STORAGE_BUCKET),
# or supabase (Supabase Storage; requires the vars below + AUTH_BACKEND=supabase).
# Create the bucket once in Supabase Dashboard → Storage → New bucket:
# name `moneta-uploads`, Public ON (app reads via public URLs).
STORAGE_BACKEND=local
FIREBASE_STORAGE_BUCKET=

# Supabase (auth + storage). Values live in .env locally and in Netlify
# Site settings → Environment variables in production — never in the repo.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# SUPABASE_STORAGE_BUCKET=moneta-uploads
# AUTH_BACKEND=supabase
# STORAGE_BACKEND=supabase
